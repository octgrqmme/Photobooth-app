{
  "name": "photobooth-app",
  "version": "1.0.0",
  "description": "Fullstack Photobooth Application with Camera & Printer Integration",
  "main": "server/server.js",
  "type": "module",
  "scripts": {
    "start": "node server/server.js",
    "dev:server": "node server/server.js",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"node server/server.js\" \"npm --prefix client run dev\"",
    "build": "npm --prefix client run build"
  },
  "keywords": [
    "photobooth",
    "camera",
    "printer",
    "cups",
    "diy-photobooth"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "multer": "^2.1.1",
    "qrcode": "^1.5.4"
  }
}

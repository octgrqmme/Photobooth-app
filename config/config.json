  "share": {
    "sharing_enabled": true,
    "actions": [
      {
        "name": "Printing",
        "handles_images_only": true,
        "processing": {
          "share_command": "lp -d {printer_name} -n {copies} -o media=4x6.Fullbleed -o PageSize=4x6.Fullbleed -o sides=one-sided -o fit-to-page \"{filename}\"",
          "printer_name": "Brother_DCP_T830DW",
          "check_if_printer_is_idle": false,
          "ask_user_for_parameter_input": false,
          "parameters_dialog_caption": "Make your choice!",
          "parameters_dialog_action_icon": "print",
          "parameters_dialog_action_label": "GO",
          "parameters": [
            {
              "key": "copies",
              "label": "Copies",
              "ui_type": "int",
              "default": "1",
              "valid_min": "1",
              "valid_max": "10"
            }
          ],
          "share_blocked_time": 3,
          "max_shares": 0
        },
        "trigger": {
          "ui_trigger": {
            "show_button": true,
            "title": "พิมพ์ (4x6 นิ้ว)",
            "icon": "print",
            "use_custom_color": false,
            "custom_color": "#196cb0"
          },
          "keyboard_trigger": {
            "keycode": "p"
          },
          "gpio_trigger": {
            "pin": "23",
            "trigger_on": "pressed"
          }
        }
      },
      {
        "name": "AirDrop",
        "handles_images_only": true,
        "processing": {
          "share_command": "open -a /System/Library/CoreServices/Finder.app/Contents/Applications/AirDrop.app && open -R \"{filename}\"",
          "printer_name": "Brother_DCP_T830DW",
          "check_if_printer_is_idle": false,
          "ask_user_for_parameter_input": false,
          "parameters_dialog_caption": "Share via AirDrop",
          "parameters_dialog_action_icon": "near_me",
          "parameters_dialog_action_label": "AirDrop",
          "parameters": [],
          "share_blocked_time": 2,
          "max_shares": 0
        },
        "trigger": {
          "ui_trigger": {
            "show_button": true,
            "title": "แชร์ (AirDrop)",
            "icon": "near_me",
            "use_custom_color": false,
            "custom_color": "#0284c7"
          },
          "keyboard_trigger": {
            "keycode": "a"
          },
          "gpio_trigger": {
            "pin": "",
            "trigger_on": "pressed"
          }
        }
      }
